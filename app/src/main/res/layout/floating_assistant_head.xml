<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/floating_head_bg"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/floating_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="CogniAgent Pływający Dymek" />
    </LinearLayout>

    <ImageView
        android:id="@+id/floating_close"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:background="@drawable/floating_close_bg"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="Zamknij dymek" />

</FrameLayout>
