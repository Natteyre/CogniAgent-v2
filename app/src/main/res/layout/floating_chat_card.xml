<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_chat_container"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CogniAgent Mini Czat"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_floating_fullscreen"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@android:drawable/ic_menu_crop"
            android:tint="#94A3B8"
            android:contentDescription="Pełny ekran"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/btn_floating_collapse"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#EF4444"
            android:contentDescription="Zwiń" />
    </LinearLayout>

    <!-- Response Box -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginTop="8dp"
        android:background="#0A0F1D"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_floating_response"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="W czym mogę pomóc? Dotknij mikrofonu lub wpisz polecenie."
            android:textColor="#E2E8F0"
            android:textSize="12sp" />
    </ScrollView>

    <!-- Quick action chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_floating_screen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="👁️ Odczytaj ekran"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/chip_floating_torch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Latarka"
            android:textColor="#FCD34D"
            android:textSize="11sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/chip_floating_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Bateria"
            android:textColor="#A78BFA"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Input row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_floating_input"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="#1E293B"
            android:paddingHorizontal="8dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:hint="Wpisz polecenie..."
            android:textSize="12sp"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/btn_floating_mic"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_widget_mic"
            android:contentDescription="Mikrofon" />

        <ImageView
            android:id="@+id/btn_floating_send"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:src="@android:drawable/ic_menu_send"
            android:tint="#00E5FF"
            android:contentDescription="Wyślij" />
    </LinearLayout>

</LinearLayout>
